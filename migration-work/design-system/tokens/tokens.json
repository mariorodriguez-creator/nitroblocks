{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "generator": "migration-design-system",
    "version": "1.0.0",
    "source": "./migration-work/design-extract/",
    "normalizedFrom": "zonnic-ca-design-tokens.json",
    "notes": "W3C DTCG mirror of tokens.css; regenerate from Pencil canvas via get_variables once propagated."
  },
  "color": {
    "brand": {
      "primary":       { "$value": "#182465", "$type": "color", "$description": "Navy. Merged C1 + #252d65 (5 040 uses)." },
      "primary-hover": { "$value": "#141e53", "$type": "color", "$description": "Darker navy (962 uses)." },
      "primary-deep":  { "$value": "#141e53", "$type": "color", "$description": "Alias of primary-hover." },
      "secondary":     { "$value": "#3860be", "$type": "color", "$description": "Mid-blue (28 uses); links, info, focus." },
      "accent":        { "$value": "#a0ff9d", "$type": "color", "$description": "Mint (8 uses); high-impact CTA." }
    },
    "surface": {
      "base":          { "$value": "#ffffff", "$type": "color" },
      "sunken":        { "$value": "#f6f6f6", "$type": "color" },
      "raised":        { "$value": "#ebecf1", "$type": "color" },
      "inverse":       { "$value": "{color.brand.primary}", "$type": "color" },
      "inverse-deep":  { "$value": "{color.brand.primary-hover}", "$type": "color" }
    },
    "text": {
      "primary":     { "$value": "#000000", "$type": "color" },
      "heading":     { "$value": "{color.brand.primary}", "$type": "color" },
      "strong":      { "$value": "#2f2f2f", "$type": "color" },
      "secondary":   { "$value": "#616069", "$type": "color", "$description": "Most-used color on source (9 804 uses)." },
      "muted":       { "$value": "#808080", "$type": "color" },
      "inverse":     { "$value": "#ffffff", "$type": "color" },
      "link":        { "$value": "{color.brand.primary}", "$type": "color" },
      "link-hover":  { "$value": "{color.brand.secondary}", "$type": "color" }
    },
    "border": {
      "subtle":   { "$value": "{color.surface.raised}", "$type": "color" },
      "default":  { "$value": "#dedede", "$type": "color", "$description": "Matches site-declared --border-color." },
      "strong":   { "$value": "#9a9ca8", "$type": "color" }
    },
    "state": {
      "error":           { "$value": "#e00830", "$type": "color" },
      "error-surface":   { "$value": "#fdecef", "$type": "color", "$description": "Derived; AA with error fg." },
      "success":         { "$value": "#4cae04", "$type": "color" },
      "success-surface": { "$value": "#e3ffe2", "$type": "color" },
      "warning":         { "$value": "#c2410c", "$type": "color", "$description": "Derived — DS-01 pending sign-off." },
      "warning-surface": { "$value": "#fff4e5", "$type": "color", "$description": "Derived." },
      "info":            { "$value": "{color.brand.secondary}", "$type": "color" }
    },
    "focusRing": {
      "$value": "rgba(56, 96, 190, 0.4)",
      "$type": "color",
      "$description": "brand-secondary at 40% alpha."
    }
  },
  "typography": {
    "fontFamily": {
      "primary": {
        "$value": "'Santral', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$type": "fontFamily"
      },
      "fallback": {
        "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "xs":      { "$value": "12px",  "$type": "dimension" },
      "sm":      { "$value": "14px",  "$type": "dimension" },
      "base":    { "$value": "16px",  "$type": "dimension" },
      "body-lg": { "$value": "18px",  "$type": "dimension" },
      "md":      { "$value": "20px",  "$type": "dimension" },
      "lg":      { "$value": "24px",  "$type": "dimension" },
      "xl":      { "$value": "32px",  "$type": "dimension" },
      "xxl":     { "$value": "42px",  "$type": "dimension" }
    },
    "fontWeight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "semibold":  { "$value": 700, "$type": "fontWeight" },
      "bold":      { "$value": 800, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":    { "$value": 1.1,  "$type": "number" },
      "snug":     { "$value": 1.25, "$type": "number" },
      "normal":   { "$value": 1.4,  "$type": "number" },
      "relaxed":  { "$value": 1.5,  "$type": "number" }
    },
    "letterSpacing": {
      "tight":   { "$value": "-0.01em", "$type": "dimension" },
      "normal":  { "$value": "0",       "$type": "dimension" }
    }
  },
  "space": {
    "0":  { "$value": "0",      "$type": "dimension" },
    "1":  { "$value": "4px",    "$type": "dimension" },
    "2":  { "$value": "8px",    "$type": "dimension" },
    "3":  { "$value": "12px",   "$type": "dimension" },
    "4":  { "$value": "16px",   "$type": "dimension" },
    "5":  { "$value": "20px",   "$type": "dimension" },
    "6":  { "$value": "24px",   "$type": "dimension" },
    "8":  { "$value": "32px",   "$type": "dimension" },
    "10": { "$value": "40px",   "$type": "dimension" },
    "12": { "$value": "48px",   "$type": "dimension" },
    "14": { "$value": "56px",   "$type": "dimension" },
    "16": { "$value": "64px",   "$type": "dimension" },
    "20": { "$value": "80px",   "$type": "dimension" },
    "24": { "$value": "96px",   "$type": "dimension" },
    "30": { "$value": "120px",  "$type": "dimension" },
    "36": { "$value": "144px",  "$type": "dimension" },
    "52": { "$value": "208px",  "$type": "dimension" },
    "64": { "$value": "256px",  "$type": "dimension" },
    "80": { "$value": "320px",  "$type": "dimension" }
  },
  "container": {
    "narrow":   { "$value": "640px",  "$type": "dimension" },
    "default":  { "$value": "960px",  "$type": "dimension" },
    "wide":     { "$value": "1200px", "$type": "dimension" },
    "xl":       { "$value": "1440px", "$type": "dimension" }
  },
  "shadow": {
    "sm":    { "$value": "0 2px 5px rgba(47, 47, 47, 0.3)", "$type": "shadow" },
    "md":    { "$value": "0 4px 8px rgba(0, 0, 0, 0.2)",    "$type": "shadow" },
    "lg":    { "$value": "0 6px 12px rgba(0, 0, 0, 0.2)",   "$type": "shadow" },
    "focus": { "$value": "0 0 0 3px {color.focusRing}",     "$type": "shadow" }
  },
  "radius": {
    "none":  { "$value": "0",      "$type": "dimension" },
    "sm":    { "$value": "6px",    "$type": "dimension" },
    "md":    { "$value": "14px",   "$type": "dimension" },
    "lg":    { "$value": "20px",   "$type": "dimension" },
    "full":  { "$value": "9999px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "fast":  { "$value": "150ms", "$type": "duration" },
      "base":  { "$value": "250ms", "$type": "duration" },
      "slow":  { "$value": "500ms", "$type": "duration" }
    },
    "easing": {
      "out":     { "$value": [0.16, 1, 0.3, 1],   "$type": "cubicBezier" },
      "in":      { "$value": [0.64, 0, 0.78, 0],  "$type": "cubicBezier" },
      "in-out":  { "$value": [0.65, 0, 0.35, 1],  "$type": "cubicBezier" },
      "linear":  { "$value": [0, 0, 1, 1],        "$type": "cubicBezier" }
    }
  }
}
