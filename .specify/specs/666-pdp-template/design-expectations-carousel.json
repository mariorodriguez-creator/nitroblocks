{
  "component": "carousel-product",
  "cssPath": "blocks/carousel/carousel.css",
  "expectations": [
    {
      "id": "cp-root-padding",
      "selector": ".carousel.product",
      "media": null,
      "properties": {
        "padding": { "value": "0 16px", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-flex-mobile",
      "selector": ".carousel.product .carousel-slide",
      "media": null,
      "properties": {
        "display": { "value": "flex", "acceptVar": false },
        "flex-direction": { "value": "row", "acceptVar": false },
        "align-items": { "value": "center", "acceptVar": false },
        "border-radius": { "value": "12px", "acceptVar": false },
        "padding": { "value": "24px", "acceptVar": false },
        "gap": { "value": "16px", "acceptVar": false },
        "min-height": { "value": "140px", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-image-flex",
      "selector": ".carousel.product .carousel-slide .carousel-slide-image",
      "media": null,
      "properties": {
        "flex": { "value": "1", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-h2-mobile",
      "selector": ".carousel.product .carousel-slide h2",
      "media": null,
      "properties": {
        "font-size": { "value": "18px", "acceptVar": true },
        "font-weight": { "value": "800", "acceptVar": false },
        "text-transform": { "value": "uppercase", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-button-mobile",
      "selector": ".carousel.product .carousel-slide .button",
      "media": null,
      "properties": {
        "font-size": { "value": "12px", "acceptVar": true },
        "font-weight": { "value": "700", "acceptVar": false },
        "text-transform": { "value": "uppercase", "acceptVar": false },
        "border-radius": { "value": "24px", "acceptVar": false }
      }
    },
    {
      "id": "cp-slides-tablet",
      "selector": ".carousel.product .carousel-slides",
      "media": "600",
      "properties": {
        "display": { "value": "flex", "acceptVar": false },
        "gap": { "value": "16px", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-tablet",
      "selector": ".carousel.product .carousel-slide",
      "media": "600",
      "properties": {
        "flex": { "value": "0 0 calc(50% - 8px)", "acceptVar": false }
      }
    },
    {
      "id": "cp-slides-desktop",
      "selector": ".carousel.product .carousel-slides",
      "media": "900",
      "properties": {
        "display": { "value": "flex", "acceptVar": false },
        "gap": { "value": "16px", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-desktop",
      "selector": ".carousel.product .carousel-slide",
      "media": "900",
      "properties": {
        "flex": { "value": "1", "acceptVar": false }
      }
    },
    {
      "id": "cp-card-h2-desktop",
      "selector": ".carousel.product .carousel-slide h2",
      "media": "900",
      "properties": {
        "font-size": { "value": "22px", "acceptVar": true }
      }
    }
  ]
}
