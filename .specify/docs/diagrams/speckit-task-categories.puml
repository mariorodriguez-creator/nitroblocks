@startuml speckit-task-categories
!theme plain
skinparam class {
  BackgroundColor #E8F4F8
  BorderColor #333
}

abstract class "TaskCategory" {
  + category name
  + dependencies
  --
  + getTasks()
}

class "EDS block" as comp {
  blocks/*.js (decorate)
  blocks/*.css (scoped)
  block table / content model
  variants (block options)
  section metadata (if any)
}
class "Data Model" as dm {
  authored examples
  rows / cells / metadata
  placeholders (if any)
}
class "Integration" as int {
  external services
  loadScript / delayed.js
  error handling
}
class "Content structure" as content {
  section breaks
  default content
  block tables in source docs
}
class "Testing" as test {
  unit tests (keeper)
  browser / preview checks
  drafts / test URLs
}
class "Documentation" as doc {
  block README
  authoring guide
  spec / quickstart
}

comp ..|> TaskCategory
dm ..|> TaskCategory
int ..|> TaskCategory
content ..|> TaskCategory
test ..|> TaskCategory
doc ..|> TaskCategory

comp ..> dm : uses
comp ..> content : uses
comp ..> test : requires
comp ..> doc : requires
int ..> dm : uses
content ..> comp : configures
@enduml
